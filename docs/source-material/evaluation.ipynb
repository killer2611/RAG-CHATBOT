   "source": [
    "metrics = [\n",
    "    FaithfulnessMetric(threshold=0.7, model=judge_model),\n",
    "    AnswerRelevancyMetric(threshold=0.7, model=judge_model),\n",
    "    ContextualPrecisionMetric(threshold=0.7, model=judge_model),\n",
    "    ContextualRecallMetric(threshold=0.7, model=judge_model),\n",
    "]\n",
    "\n",
    "print(f\"Building {len(golden_qa_pairs)} test cases...\")\n",
    "test_case = []\n",
    "\n",
    "for i, (q, a) in enumerate(golden_qa_pairs):\n",
    "    print(\n",
    "        f\"  [{i+1}/{len(golden_qa_pairs)}] Generating response for: {q[:45]}...\"\n",
    "    )\n",
    "    test_config = {\"configurable\": {\"session_id\": f\"eval_session_{i}\"}}\n",
    "\n",
    "    # Query local Ollama pipeline\n",
    "    result = chatbot.invoke({\"input\": q}, config=test_config)\n",
    "    docs = retriever.invoke(q)\n",
    "\n",
    "    # Package into DeepEval test case\n",
    "    tc = LLMTestCase(\n",
    "        input=q,\n",
    "        expected_output=a,\n",
    "        actual_output=result[\"answer\"],\n",
    "        retrieval_context=[doc.page_content for doc in docs],\n",
    "    )\n",
    "    test_case.append(tc)\n",
    "\n",
    "print(\n",
    "    f\"\\n✅ All {len(test_case)} test cases created. Starting Gemini evaluation...\"\n",
    ")\n",
    "async_config = AsyncConfig(run_async=False)\n",
    "error_config = ErrorConfig(ignore_errors=True)\n",
    "print(judge_model.generate(\"Say: Active\"))\n",
    "print(\"\\nStarting evaluation...\")\n",
    "results = evaluate(\n",
    "    test_case,\n",
    "    metrics,\n",
    "    cache_config=CacheConfig(write_cache=False, use_cache=False),\n",
    "    async_config=async_config,\n",
    "    error_config=error_config\n",
    ")\n",
    "records = []\n",
    "for result in results.test_results:\n",
    "    print(f\"\\nQuestion: {result.input}\")\n",
    "    \n",
    "    # Initialize the row structure for CSV\n",
    "    row = {\n",
    "        \"Question\": result.input,\n",
    "        \"Actual Output\": result.actual_output,\n",
    "        \"Expected Output\": result.expected_output,\n",
    "        \"Success\": result.success,\n",
    "    }\n",
    "    for metric_data in result.metrics_data:\n",
    "        score_val = f\"{metric_data.score:.2f}\" if metric_data.score is not None else \"N/A\"\n",
    "        print(f\"  {metric_data.name}: score={score_val} passed={metric_data.success} reason={metric_data.reason}\")\n",
    "        \n",
    "        if metric_data.error:\n",
    "            print(f\"  failed={metric_data.error}\")\n",
    "        row[f\"{metric_data.name} Score\"] = round(metric_data.score, 2) if metric_data.score is not None else None\n",
    "        row[f\"{metric_data.name} Passed\"] = metric_data.success\n",
    "        row[f\"{metric_data.name} Reason\"] = metric_data.reason    \n",
    "    records.append(row)\n",
    "    df_eval = pd.DataFrame(records)\n",
    "df_eval.to_csv(\"rag_final_20_eval_report.csv\", index=False)\n",
    "print(\"\\n\" + \"=\"*50)\n",
    "print(\"✅ Saved full report to rag_final_20_eval_report.csv\")\n",
    "print(\"=\"*50)"
   ]
  }
