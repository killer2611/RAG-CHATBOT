APP_NAME=rag-production-system
ENVIRONMENT=development
LOG_LEVEL=INFO
ALLOWED_ORIGINS=http://localhost:3000,http://localhost:8501

CHAT_PROVIDER=groq
GROQ_API_KEY=
GROQ_MODEL=llama-3.3-70b-versatile
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.5-flash
OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_MODEL=deepseek-r1:8b
CHAT_TEMPERATURE=0.1

EMBEDDING_MODEL=sentence-transformers/all-MiniLM-L6-v2
RERANKER_MODEL=BAAI/bge-reranker-base
RERANKER_DEVICE=
VECTOR_STORE_DIR=data/vectorstore
PARENT_STORE_DB=data/parent_store/parents.sqlite3
PARENT_CHUNK_SIZE=800
PARENT_CHUNK_OVERLAP=150
CHILD_CHUNK_SIZE=300
CHILD_CHUNK_OVERLAP=60
RETRIEVAL_K=10
RERANK_TOP_N=3

DATABASE_URL=sqlite+aiosqlite:///./data/chat_history.sqlite3
HISTORY_MAX_MESSAGES=24
MAX_UPLOAD_MB=25

EVAL_JUDGE=ollama
EVAL_OLLAMA_MODEL=deepseek-r1:8b
EVAL_OLLAMA_BASE_URL=http://localhost:11434
EVAL_GEMINI_MODEL=gemini-2.5-flash
EVAL_GEMINI_API_KEY=
EVAL_THRESHOLD=0.7
EVAL_MAX_CONCURRENT=1
EVAL_THROTTLE_SECONDS=2
EVAL_REPORT_DIR=data/reports
