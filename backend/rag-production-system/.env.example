APP_NAME=rag-production-system
ENVIRONMENT=development
LOG_LEVEL=INFO
ALLOWED_ORIGINS=http://localhost:3000,http://localhost:8501

# Normal chat provider
CHAT_PROVIDER=groq
GROQ_API_KEY=YOUR_GROQ_API_KEY
GROQ_MODEL=qwen/qwen3.6-27b

# Optional chat providers
GEMINI_API_KEY=YOUR_GEMINI_API_KEY
GEMINI_MODEL=gemini-3.6-flash
OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_MODEL=qwen3:8b
CHAT_TEMPERATURE=0.1

# Retrieval
EMBEDDING_MODEL=sentence-transformers/all-MiniLM-L6-v2
RERANKER_MODEL=BAAI/bge-reranker-base
RERANKER_DEVICE=
VECTOR_STORE_DIR=data/vectorstore
PARENT_STORE_DB=data/parent_store/parents.sqlite3
PARENT_CHUNK_SIZE=800
PARENT_CHUNK_OVERLAP=150
CHILD_CHUNK_SIZE=300
CHILD_CHUNK_OVERLAP=60
RETRIEVAL_K=10
RERANK_TOP_N=3

# Application state
DATABASE_URL=sqlite+aiosqlite:///./data/chat_history.sqlite3
HISTORY_MAX_MESSAGES=24
MAX_UPLOAD_MB=25

# CLOUD-ONLY evaluation
EVAL_JUDGE=deepseek

# Primary evaluation judge
EVAL_DEEPSEEK_API_KEY=YOUR_DEEPSEEK_API_KEY
EVAL_DEEPSEEK_BASE_URL=https://api.deepseek.com
EVAL_DEEPSEEK_MODEL=deepseek-v4-flash

# Secondary/free cloud judge
EVAL_SAMBANOVA_API_KEY=YOUR_SAMBANOVA_API_KEY
EVAL_SAMBANOVA_BASE_URL=https://api.sambanova.ai/v1
EVAL_SAMBANOVA_MODEL=Meta-Llama-3.3-70B-Instruct

EVAL_THRESHOLD=0.7
EVAL_MAX_CONCURRENT=1
EVAL_THROTTLE_SECONDS=2
EVAL_REPORT_DIR=data/reports
